{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PROJECT_DIR}/.claude/ponytail\" node \"${CLAUDE_PROJECT_DIR}/.claude/ponytail/hooks/ponytail-activate.js\"", "timeout": 15, "statusMessage": "Loading ponytail mode..." }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PROJECT_DIR}/.claude/ponytail\" node \"${CLAUDE_PROJECT_DIR}/.claude/ponytail/hooks/ponytail-mode-tracker.js\"", "timeout": 15, "statusMessage": "Tracking ponytail mode..." } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PROJECT_DIR}/.claude/ponytail\" node \"${CLAUDE_PROJECT_DIR}/.claude/ponytail/hooks/ponytail-subagent.js\"", "timeout": 15 } ] }
    ]
  }
}
