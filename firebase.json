{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix functions install",
        "npm --prefix functions run build"
      ],
      "ignore": [
        "node_modules",
        "src",
        "tsconfig.json",
        ".git"
      ]
    }
  ]
}