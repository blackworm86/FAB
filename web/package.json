    "shots": "node e2e/shots.mjs",
    "shots:compare": "COMPARE=1 node e2e/shots.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "playwright": "^1.63.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.8"
  }
}
