{
  "name": "fab-web",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "node e2e/smoke.mjs",
