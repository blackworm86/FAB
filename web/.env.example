# Copy to web/.env.local for local development. On GitHub, set the same names as repository variables (Settings > Secrets and variables > Actions > Variables).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
# URL of the free Netlify referee (for example https://fab-referee.netlify.app). When set, new games are refereed: hidden blocks stay on the server.
VITE_REFEREE_URL=
