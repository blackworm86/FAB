# Copy to web/.env.local for local development. On GitHub, set the same names as repository variables (Settings > Secrets and variables > Actions > Variables).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
# Set to 1 once the Cloud Functions referee is deployed: new games are then refereed (hidden blocks are kept on the server).
VITE_USE_FUNCTIONS=
