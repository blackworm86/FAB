# Copy to web/.env.local for local development. On GitHub, set the same names as repository variables (Settings > Secrets and variables > Actions > Variables).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
# Realtime Database address (Firebase console, Build, Realtime Database), for example https://<project>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
