rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Guests sign in anonymously to watch; playing needs a Google or email account.
    function isPlayer() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // Admins are listed by hand in the console: document admins/<their uid>.
    function isAdmin() { return isPlayer() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function seats(table) { return get(/databases/$(database)/documents/tables/$(table)/docs/seats).data; }
    function seated(table) {
      return exists(/databases/$(database)/documents/tables/$(table)/docs/seats)
        && (seats(table).get('german', '') == request.auth.uid || seats(table).get('allied', '') == request.auth.uid);
    }
    // A seat field may stay as it is, or change to nobody, or to the writer, and only from nobody or from the writer.
    function matchOwner(t) { return exists(/databases/$(database)/documents/matches/$(t)) && get(/databases/$(database)/documents/matches/$(t)).data.owner == request.auth.uid; }
    function seatOk(old, nw) { return old == nw || ((nw == null || nw == request.auth.uid) && (old == null || old == request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Lobby records. Anyone signed in may read one (to open an invite link); only the creator makes it; a joining player may add themself.
    match /matches/{id} {
      allow read: if signedIn();
      allow create: if isPlayer() && request.resource.data.owner == request.auth.uid && request.resource.data.members == [request.auth.uid];
      allow update: if isPlayer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'germanName', 'alliedName'])
        && ((request.resource.data.members.hasAll(resource.data.members) && request.resource.data.members.size() <= resource.data.members.size() + 1)
            || (request.auth.uid in resource.data.members && resource.data.members.hasAll(request.resource.data.members) && request.resource.data.members.size() == resource.data.members.size() - 1));
      allow delete: if isPlayer() && (resource.data.owner == request.auth.uid || isAdmin());
    }
    // Hidden blocks (split tables): the shared game in docs/state holds hidden blocks as opaque placeholders; each seat keeps the details of its own
    // blocks in priv/{side}, which only that seat can read, and publishes details the other side may see into docs/reveals. docs/meta marks such a table.
    match /tables/{table}/priv/{side} {
      allow read: if isPlayer() && seats(table).get(side, '') == request.auth.uid;
      allow create: if isPlayer();
      allow update: if isPlayer() && seats(table).get(side, '') == request.auth.uid;
      allow delete: if isPlayer() && (isAdmin() || matchOwner(table));
    }
    match /tables/{table}/docs/meta {
      allow read: if signedIn();
      allow create: if isPlayer();
      allow delete: if isPlayer() && (isAdmin() || matchOwner(table));
    }
    match /tables/{table}/docs/reveals {
      allow read: if signedIn();
      allow write: if isPlayer() && seated(table);
      allow delete: if isPlayer() && (isAdmin() || matchOwner(table));
    }
    match /tables/{table}/docs/state {
      allow read: if signedIn();
      allow delete: if isPlayer() && (isAdmin() || matchOwner(table));
      allow write: if isPlayer() && request.resource.data.keys().hasOnly(['rev', 'json', 'by'])
        && request.resource.data.json.size() < 900000
        && (isAdmin() || seated(table) || !exists(/databases/$(database)/documents/tables/$(table)/docs/seats));
    }
    match /tables/{table}/docs/seats {
      allow read: if signedIn();
      allow delete: if isPlayer() && (isAdmin() || matchOwner(table));
      allow create, update: if isPlayer() && request.resource.data.keys().hasOnly(['german', 'allied', 'germanName', 'alliedName'])
        && (isAdmin()
            || (seatOk(resource == null ? null : resource.data.get('german', null), request.resource.data.get('german', null))
             && seatOk(resource == null ? null : resource.data.get('allied', null), request.resource.data.get('allied', null))));
    }
  }
}
